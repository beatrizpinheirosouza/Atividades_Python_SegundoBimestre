5) Monitor de tráfego de rede
import psutil
import time

anterior = psutil.net_io_counters()

while True:
    time.sleep(1)

    atual = psutil.net_io_counters()

    download = atual.bytes_recv - anterior.bytes_recv
    upload = atual.bytes_sent - anterior.bytes_sent

    print("Download:", round(download / 1024, 2), "KB/s")
    print("Upload:", round(upload / 1024, 2), "KB/s")

    anterior = atual

