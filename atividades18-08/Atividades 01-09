8. Jogo de adivinhação
import random
numero = random.randint(1, 100)
tentativas = 0
while True:
    palpite = int(input("Tente adivinhar: "))
    tentativas += 1
    if palpite == numero:
        print("Acertou!")
        print("Tentativas:", tentativas)
        break
    elif palpite < numero:
        print("O número é maior!")
    else:
        print("O número é menor!")

