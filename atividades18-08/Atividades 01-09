4) Alerta de pouco espaço
import psutil

limite = 10

for p in psutil.disk_partitions():
    try:
        uso = psutil.disk_usage(p.mountpoint)
        livre = 100 - uso.percent

        if livre < limite:
            print("ALERTA:", p.mountpoint, "está com pouco espaço!")
            print("Espaço livre:", round(livre, 2), "%")

    except PermissionError:
        pass

