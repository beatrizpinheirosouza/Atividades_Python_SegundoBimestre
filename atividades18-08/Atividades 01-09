3) Gerenciador de espaço em disco
import psutil

particoes = psutil.disk_partitions()

for p in particoes:
    try:
        uso = psutil.disk_usage(p.mountpoint)

        print("\nPartição:", p.mountpoint)
        print("Total:", round(uso.total / 1024**3, 2), "GB")
        print("Usado:", round(uso.used / 1024**3, 2), "GB")
        print("Livre:", round(uso.free / 1024**3, 2), "GB")
        print("Uso:", uso.percent, "%")

    except PermissionError:
        pass

