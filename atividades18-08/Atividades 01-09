1) Monitor de memória RAM
import psutil
import time

while True:
    memoria = psutil.virtual_memory()

    print("=== MEMÓRIA RAM ===")
    print("Total:", round(memoria.total / 1024**2, 2), "MB")
    print("Usada:", round(memoria.used / 1024**2, 2), "MB")
    print("Livre:", round(memoria.available / 1024**2, 2), "MB")
    print("Uso:", memoria.percent, "%")

    time.sleep(2)

