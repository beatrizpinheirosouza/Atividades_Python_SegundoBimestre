10) Painel integrado — RAM + CPU + Disco + Rede
import psutil
import time
import os

anterior = psutil.net_io_counters()

while True:
    time.sleep(2)

    memoria = psutil.virtual_memory()
    cpu = psutil.cpu_percent()
    disco = psutil.disk_usage("/")
    atual = psutil.net_io_counters()

    download = (atual.bytes_recv - anterior.bytes_recv) / 1024
    upload = (atual.bytes_sent - anterior.bytes_sent) / 1024

    os.system("cls" if os.name == "nt" else "clear")

    print("=== PAINEL DE MONITORAMENTO ===")
    print("RAM:", memoria.percent, "% -",
          round(memoria.used / 1024**2, 2), "MB usados")

    print("CPU:", cpu, "%")

    print("Disco livre:",
          round(disco.free / 1024**3, 2), "GB")

    print("Download:", round(download / 2, 2), "KB/s")
    print("Upload:", round(upload / 2, 2), "KB/s")

    anterior = atual
